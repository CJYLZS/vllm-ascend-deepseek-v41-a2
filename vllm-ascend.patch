+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Per-builder reuse in the V4.1 metadata builder.
+
+A V4.1 decode step runs ``build`` once per KV cache group, so anything it
+derives from the config, from a constant, or from another builder of the same
+layout is worth resolving once. These tests pin the equivalence of that reuse:
+the cached paths must produce exactly the values the straightforward path did.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm_ascend.attention import dsa_v41
+from vllm_ascend.attention.dsa_v41 import AscendDSAV41MetadataBuilder
+
+PREFIX = "model.layers.0.attn"
+NUM_TOKENS = 6
+
+
+class _CountingConfig(dict):
+    """Config stand-in that records which keys were read."""
+
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+        self.reads = []
+
+    def get(self, name, default=None):
+        self.reads.append(name)
+        return super().get(name, default)
+
+
+def _config(head_dim=2, index_topk=3):
+    text_config = _CountingConfig(
+        sliding_window=4,
+        num_attention_heads=2,
+        head_dim=head_dim,
+        qk_rope_head_dim=2,
+        index_topk=index_topk,
+    )
+    return (
+        SimpleNamespace(
+            parallel_config=SimpleNamespace(tensor_parallel_size=1),
+            scheduler_config=SimpleNamespace(max_num_seqs=2, max_num_batched_tokens=64),
+            speculative_config=SimpleNamespace(num_speculative_tokens=5),
+            compilation_config=SimpleNamespace(cudagraph_capture_sizes=(12,), cudagraph_mode=None),
+            cache_config=SimpleNamespace(block_size=8),
+            model_config=SimpleNamespace(hf_text_config=text_config),
+        ),
+        text_config,
+    )
+
+
+def _builder(*, tokens_per_state=2, scale_dim=0):
+    config, text_config = _config()
+    spec = dsa_v41.AscendMLAAttentionSpec(
+        block_size=8,
+        num_kv_heads=1,
+        head_size=2,
+        dtype=torch.float32,
+        tokens_per_state=tokens_per_state,
+        scale_dim=scale_dim,
+    )
+    builder = AscendDSAV41MetadataBuilder(spec, [PREFIX], config, torch.device("cpu"))
+    return builder, text_config
+
+
+def _common(slot_mapping, *, positions=None, query_start_loc=None):
+    query_start_loc = query_start_loc if query_start_loc is not None else torch.tensor([0, NUM_TOKENS], dtype=torch.int32)
+    num_reqs = len(query_start_loc) - 1
+    positions = positions if positions is not None else torch.arange(NUM_TOKENS, dtype=torch.int64)
+    seq_lens = torch.full((num_reqs,), NUM_TOKENS, dtype=torch.int32)
+    return SimpleNamespace(
+        query_start_loc=query_start_loc,
+        query_start_loc_cpu=query_start_loc.clone(),
+        seq_lens=seq_lens,
+        seq_lens_cpu=seq_lens.clone(),
+        num_reqs=num_reqs,
+        num_actual_tokens=NUM_TOKENS,
+        num_input_tokens=NUM_TOKENS,
+        max_query_len=NUM_TOKENS,
+        max_seq_len=NUM_TOKENS,
+        block_table_tensor=torch.zeros((num_reqs, 2), dtype=torch.int32),
+        slot_mapping=slot_mapping,
+        positions=positions,
+        is_prefilling=torch.zeros(num_reqs, dtype=torch.bool),
+        causal=True,
+    )
+
+
+def _reference_coordinates(common, *, ratio, storage_block_size, num_actual_reqs):
+    """The straightforward slot chain the builder is expected to reproduce."""
+    active = dsa_v41.compressed_slot_mapping(common.slot_mapping, ratio) if ratio != 1 else common.slot_mapping
+    valid = active >= 0
+    if ratio == 2:
+        valid_end = common.query_start_loc[num_actual_reqs].clamp_max(common.num_actual_tokens)
+        valid = valid & (torch.arange(NUM_TOKENS) < valid_end)
+        valid = valid & (common.positions.remainder(2) == 1)
+    physical = active.clamp_min(0)
+    column0 = torch.where(
+        valid,
+        torch.div(physical, storage_block_size, rounding_mode="floor"),
+        torch.tensor(-1),
+    )
+    column1 = torch.where(valid, physical.remainder(storage_block_size), torch.tensor(-1))
+    flat = torch.where(valid, active, torch.tensor(-1))
+    return torch.stack([column0, column1], dim=-1).to(torch.int32), flat
+
+
+def test_sentinel_reuses_one_tensor_and_matches_scalar_where():
+    builder, _ = _builder()
+    first = builder._sentinel(-1, torch.int32)
+    assert first is builder._sentinel(-1, torch.int32)
+    assert builder._sentinel(0, torch.int32) is not first
+    assert first.shape == () and first.item() == -1
+
+    condition = torch.tensor([True, False, True])
+    values = torch.tensor([5, 6, 7], dtype=torch.int32)
+    expected = torch.where(condition, values, -1)
+    assert torch.equal(torch.where(condition, values, first), expected)
+    assert torch.where(condition, values, first).dtype == expected.dtype
+
+
+def test_index_const_reads_the_config_once():
+    builder, text_config = _builder()
+    text_config.reads.clear()
+    assert builder._index_const("head_dim") == 2
+    assert builder._index_const("head_dim") == 2
+    assert text_config.reads.count("head_dim") == 1
+    # A different key is still resolved on demand.
+    assert builder._index_const("index_topk") == 3
+    assert text_config.reads.count("index_topk") == 1
+
+
+def test_slot_mapping_shared_by_builders_of_the_same_layout():
+    first_builder, _ = _builder()
+    second_builder, _ = _builder()
+    slots = torch.tensor([6, 7, 8, 9, 10, 11], dtype=torch.int64)
+    common = _common(slots)
+    shared = {}
+
+    first = first_builder.build(0, common, common_v41_metadata=shared)
+    second = second_builder.build(0, common, common_v41_metadata=shared)
+
+    assert first.slot_mapping is second.slot_mapping
+    assert first.flat_slot_mapping is second.flat_slot_mapping
+    # Different builders, so the shared buffers come from the first one.
+    assert first.slot_mapping.untyped_storage().data_ptr() == second.slot_mapping.untyped_storage().data_ptr()
+
+
+def test_slot_mapping_matches_the_unshared_chain():
+    builder, _ = _builder()
+    slots = torch.tensor([6, 7, 8, 9, 10, 11], dtype=torch.int64)
+    common = _common(slots)
+    metadata = builder.build(0, common, common_v41_metadata={})
+
+    ratio = metadata.compress_ratio
+    assert ratio == 2
+    expected_coordinates, expected_flat = _reference_coordinates(
+        common,
+        ratio=ratio,
+        storage_block_size=metadata.storage_block_size,
+        num_actual_reqs=metadata.num_actual_reqs,
+    )
+    assert torch.equal(metadata.slot_mapping, expected_coordinates)
+    assert torch.equal(metadata.flat_slot_mapping, expected_flat)
+    # Only completed compression groups with odd positions may write.
+    assert metadata.flat_slot_mapping.tolist() == [-1, 3, -1, 4, -1, 5]
+
+
+def test_flat_slot_mapping_ignores_the_storage_block_size(monkeypatch):
+    """Long KV and Indexer planes of one group share the flat mapping."""
+    slots = torch.tensor([6, 7, 8, 9, 10, 11], dtype=torch.int64)
+    common = _common(slots)
+    shared = {}
+
+    small, _ = _builder()
+    monkeypatch.setattr(dsa_v41, "get_storage_block_size", lambda spec: 4)
+    first = small.build(0, common, common_v41_metadata=shared)
+
+    large, _ = _builder()
+    monkeypatch.setattr(dsa_v41, "get_storage_block_size", lambda spec: 8)
+    second = large.build(0, common, common_v41_metadata=shared)
+
+    assert first.storage_block_size == 4
+    assert second.storage_block_size == 8
+    # The physical coordinates are block-size dependent, so they are rebuilt...
+    assert first.slot_mapping is not second.slot_mapping
+    assert first.slot_mapping.tolist() != second.slot_mapping.tolist()
+    # ...but the flat mapping carries no physical-block component.
+    assert first.flat_slot_mapping is second.flat_slot_mapping
+    assert first.flat_slot_mapping.tolist() == second.flat_slot_mapping.tolist()
+
+
+def test_slot_mapping_is_not_reused_across_groups():
+    """Two KV cache groups allocate independent physical blocks."""
+    builder, _ = _builder()
+    first_slots = torch.tensor([6, 7, 8, 9, 10, 11], dtype=torch.int64)
+    second_slots = torch.tensor([26, 27, 28, 29, 30, 31], dtype=torch.int64)
+
+    # Metadata holds a view of the builder's persistent buffer, so each result
+    # has to be snapshotted before the next build writes over it.
+    first = builder.build(0, _common(first_slots), common_v41_metadata={}).flat_slot_mapping.tolist()
+    second = builder.build(0, _common(second_slots), common_v41_metadata={}).flat_slot_mapping.tolist()
+
+    assert first == [-1, 3, -1, 4, -1, 5]
+    # A group's physical blocks never reach another group's mapping.
+    assert second == [-1, 13, -1, 14, -1, 15]
+
+
+@pytest.mark.parametrize("skip_first", [True, False])
+def test_ring_state_skip_does_not_leak_between_keys(skip_first):
+    """``skip_ring_state_update`` must select its own validity mask."""
+    builder, _ = _builder()
+    slots = torch.tensor([6, 7, 8, 9, 10, 11], dtype=torch.int64)
+    common = _common(slots)
+    shared = {}
+
+    values = {}
+    for skip in (skip_first, not skip_first):
+        metadata = builder.build(0, common, common_v41_metadata=shared, skip_ring_state_update=skip)
+        values[skip] = metadata.flat_slot_mapping.tolist()
+
+    # Both policies live in one ``shared`` dict and must not share a cache key,
+    # whichever order they appear in.
+    assert values[True] == [-1] * NUM_TOKENS
+    assert values[False] == [-1, 3, -1, 4, -1, 5]
+
+
+def _kernel_semantics(slots, positions, qsl, num_actual_reqs, num_actual_tokens,
+                      page_size, ratio, skip_update):
+    """Reference for ``ops/triton/packed_cache_slot_mapping.py`` on raw slots.
+
+    The kernel divides by the compression ratio itself, so this takes the raw
+    slot mapping, exactly as the A3 call site now passes it.
+    """
+    tokens = torch.arange(slots.numel())
+    valid_end = min(int(qsl[num_actual_reqs]), num_actual_tokens)
+    active = slots if ratio == 1 else slots // ratio
+    valid = (tokens < valid_end) & (slots >= 0)
+    if ratio == 2:
+        valid = valid & (((slots + 1) % 2) == 0)
+        valid = valid & ((positions % 2) == 1)
+        valid = valid & torch.tensor(not skip_update)
+    safe = active.clamp_min(0)
+    column0 = torch.where(valid, torch.div(safe, page_size, rounding_mode="floor"), torch.tensor(-1))
+    column1 = torch.where(valid, safe.remainder(page_size), torch.tensor(-1))
+    flat = torch.where(valid, active, torch.tensor(-1))
+    return torch.stack([column0, column1], dim=-1).to(torch.int32), flat
+
+
+@pytest.mark.parametrize("skip_update", [False, True])
+def test_triton_kernel_semantics_match_the_eager_chain(skip_update):
+    """The A3 Triton arm must reproduce the eager chain bit for bit.
+
+    Checked offline because the real kernel needs an NPU; the serving-side
+    microbenchmark (``rc2/bench/micro_slot_mapping.py``) covers the compiled
+    kernel on 910B3, and this pins the semantics the call site relies on.
+    """
+    builder, _ = _builder()
+    slots = torch.tensor([6, 7, 8, 9, 10, 11], dtype=torch.int64)
+    common = _common(slots)
+    eager_metadata = builder.build(0, common, common_v41_metadata={}, skip_ring_state_update=skip_update)
+    ratio = eager_metadata.compress_ratio
+    assert ratio == 2
+
+    kernel_coordinates, kernel_flat = _kernel_semantics(
+        common.slot_mapping,
+        common.positions,
+        common.query_start_loc,
+        eager_metadata.num_actual_reqs,
+        common.num_actual_tokens,
+        eager_metadata.storage_block_size,
+        ratio,
+        skip_update,
+    )
+    assert torch.equal(kernel_coordinates, eager_metadata.slot_mapping)
+    assert torch.equal(kernel_flat, eager_metadata.flat_slot_mapping)
+
+
+def test_triton_kernel_needs_raw_slots_not_precompressed():
+    """Pin the trap: the kernel compresses, so a pre-compressed buffer is wrong.
+
+    ``dsa_v41`` builds ``active_slots = slot // ratio`` before the backend
+    branch. Feeding that to the kernel would divide twice and address
+    ``slot // 4`` for ratio 2, silently writing the wrong cache rows.
+    """
+    slots = torch.tensor([6, 7, 8, 9, 10, 11], dtype=torch.int64)
+    positions = torch.arange(NUM_TOKENS, dtype=torch.int64)
+    qsl = torch.tensor([0, NUM_TOKENS], dtype=torch.int32)
+    page_size, ratio = 4, 2
+
+    raw_coordinates, raw_flat = _kernel_semantics(
+        slots, positions, qsl, 1, NUM_TOKENS, page_size, ratio, False)
+    precompressed = dsa_v41.compressed_slot_mapping(slots, ratio)
+    pre_coordinates, pre_flat = _kernel_semantics(
+        precompressed, positions, qsl, 1, NUM_TOKENS, page_size, ratio, False)
+
+    assert raw_flat.tolist() == [-1, 3, -1, 4, -1, 5]
+    assert not torch.equal(raw_flat, pre_flat)
+    assert not torch.equal(raw_coordinates, pre_coordinates)
