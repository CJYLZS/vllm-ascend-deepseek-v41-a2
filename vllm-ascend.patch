+@pytest.mark.parametrize("draft_index", [None, 1, 2, 3])
+@pytest.mark.parametrize("dtype", [torch.int32, torch.int64])
+@pytest.mark.parametrize("rotary_dim", [8, 64])
+def test_cached_rope_index_select_matches_gather_in_resident_slots(monkeypatch, draft_index, dtype, rotary_dim):
+    table = torch.arange(16 * rotary_dim, dtype=torch.float32).reshape(16, 1, 1, rotary_dim)
+    tables = (table, -table)
+    capacity = 8
+    shape = (capacity, 1, 1, rotary_dim)
+    slots = [tuple(torch.full(shape, -999.0) for _ in range(2)) for _ in range(3)]
+    runtime = tuple(torch.full(shape, -999.0) for _ in range(2))
+    state = rope_dsv4.RopeGlobalState()
+    state.full_rope_cache = {"test": tables}
+    state.registry_summary = {"test": {"default"}}
+    state.layer_info = {"layer": ("test", ["default"])}
+    state.runtime_buffer = {"test": {"default": runtime}}
+    state.spec_runtime_buffer = {"test": {"default": ([s[0] for s in slots], [s[1] for s in slots])}}
+    monkeypatch.setattr(rope_dsv4, "_ROPE_STATE", state)
+    selected = runtime if draft_index is None else slots[draft_index - 1]
+    pointers = [t.data_ptr() for t in selected]
+
+    # Reuse the same storage across growing/shrinking and empty batches;
+    # repeated/nonmonotonic indices and a noncontiguous position view matter.
+    for values in ([7, 0, 7, 15], [2], [], [3, 1, 9]):
+        positions = torch.tensor([v for value in values for v in (value, 0)], dtype=dtype)[::2]
+        monkeypatch.setenv("VLLM_ASCEND_ROPE_INDEX_SELECT", "0")
+        old = get_cos_and_sin_dsa(positions, use_cache=True, draft_index=draft_index)
+        expected = [p["layer"].clone() for p in old]
+        for target in selected:
+            target.fill_(-999.0)
+        monkeypatch.setenv("VLLM_ASCEND_ROPE_INDEX_SELECT", "1")
+        new = get_cos_and_sin_dsa(positions, use_cache=True, draft_index=draft_index)
+        for i, proxy in enumerate(new):
+            actual = proxy["layer"]
+            assert actual.shape == (len(values), 1, 1, rotary_dim)
+            assert actual.dtype == selected[i].dtype
+            assert actual.untyped_storage().data_ptr() == selected[i].untyped_storage().data_ptr()
+            assert selected[i].data_ptr() == pointers[i]
+            torch.testing.assert_close(actual, expected[i], rtol=0, atol=0)
+            assert torch.all(selected[i][len(values) :] == -999.0)
+        if draft_index is not None:
+            for i, slot in enumerate(slots, start=1):
+                if i != draft_index:
+                    assert all(torch.all(t == -999.0) for t in slot)
+
+
+def test_rope_index_select_keeps_cached_multidimensional_gather(monkeypatch):
+    table = torch.arange(32, dtype=torch.float32).reshape(4, 1, 1, 8)
+    buffers = (torch.empty_like(table), torch.empty_like(table))
+    state = rope_dsv4.RopeGlobalState()
+    state.full_rope_cache = {"test": (table, -table)}
+    state.registry_summary = {"test": {"default"}}
+    state.layer_info = {"layer": ("test", ["default"])}
+    state.runtime_buffer = {"test": {"default": buffers}}
+    monkeypatch.setattr(rope_dsv4, "_ROPE_STATE", state)
+    monkeypatch.setenv("VLLM_ASCEND_ROPE_INDEX_SELECT", "1")
+    # The original cached path also accepts [N, 1] positions. Do not flatten
+    # arbitrary shapes into the experimental path or change its error cases.
+    positions = torch.tensor([[3], [1]])
+    cos, sin = get_cos_and_sin_dsa(positions, use_cache=True)
+    torch.testing.assert_close(cos["layer"], table[positions[:, 0]], rtol=0, atol=0)
+    torch.testing.assert_close(sin["layer"], -table[positions[:, 0]], rtol=0, atol=0)
+
+
+def test_rope_index_select_preserves_uncached_multidimensional_indexing(monkeypatch):
+    table = torch.arange(32, dtype=torch.float32).reshape(4, 1, 1, 8)
+    state = rope_dsv4.RopeGlobalState()
+    state.full_rope_cache = {"test": (table, -table)}
+    state.registry_summary = {"test": {"default"}}
+    state.layer_info = {"layer": ("test", ["default"])}
+    monkeypatch.setattr(rope_dsv4, "_ROPE_STATE", state)
+    monkeypatch.setenv("VLLM_ASCEND_ROPE_INDEX_SELECT", "1")
+    positions = torch.tensor([[0, -1], [2, 1]])
+    cos, sin = get_cos_and_sin_dsa(positions)
+    torch.testing.assert_close(cos["layer"], table[positions], rtol=0, atol=0)
+    torch.testing.assert_close(sin["layer"], -table[positions], rtol=0, atol=0)
+
+
+def test_rope_index_select_env_default_and_validation(monkeypatch):
+    monkeypatch.delenv("VLLM_ASCEND_ROPE_INDEX_SELECT", raising=False)
+    assert rope_dsv4.envs.VLLM_ASCEND_ROPE_INDEX_SELECT is False
+    monkeypatch.setenv("VLLM_ASCEND_ROPE_INDEX_SELECT", "invalid")
+    with pytest.raises(ValueError, match="must be either '0' or '1'"):
+        _ = rope_dsv4.envs.VLLM_ASCEND_ROPE_INDEX_SELECT
+
