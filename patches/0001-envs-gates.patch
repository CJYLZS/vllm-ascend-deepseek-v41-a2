@@ -28,6 +28,18 @@ from typing import Any
 # begin-env-vars-definition
 
 
+def _v41_binary_env(name: str, default: str = "0") -> bool:
+    """Strict 0/1 reader for the V41 switches: a typo must fail loudly.
+
+    Defined here (not borrowed from upstream) so the gates keep working when
+    upstream reshapes this registry.
+    """
+    value = os.getenv(name, default)
+    if value not in {"0", "1"}:
+        raise ValueError(f"{name} must be either '0' or '1', got {value!r}")
+    return value == "1"
+
+
 env_variables: dict[str, Callable[[], Any]] = {
     # max compile thread number for package building. Usually, it is set to
     # the number of CPU cores. If not set, the default value is None, which
@@ -72,6 +84,45 @@ env_variables: dict[str, Callable[[], Any]] = {
