+    "VLLM_ASCEND_V41_MOE_MASK_RANGE": lambda: _v41_binary_env("VLLM_ASCEND_V41_MOE_MASK_RANGE"),
+    # Collapse the degenerate single-group `wo_a` transpose-batchmatmul into a
