+    "VLLM_ASCEND_V41_QLI_NO_CANDIDATE": lambda: _v41_binary_env("VLLM_ASCEND_V41_QLI_NO_CANDIDATE"),
+    # Shard the Engram gate `wkv` projection across TP ranks along the output
