+    def _wo_a_2d(self, o_proj_input: torch.Tensor) -> torch.Tensor:
+        """[O_PROJ_2D] Degenerate batch matmul -> plain 2D matmul (n_local_groups == 1).
+
+        Ported from deepseek-v4.1-flash-ascend910B:patches/files/dsa_v1.py (F3,
+        `V41_O_PROJ_2D`). With a single local group the permuted batch matmul
+        `npu_transpose_batchmatmul([T, 1, H] x [1, H, R], perm=(1,0,2))` reduces
+        to `x @ w`, so a 2D GEMM is numerically identical and avoids the
+        batch-matmul tiling overhead. The transpose for the dummy 2D layout is
+        cached: doing it per call added a Transpose to every step.
+        """
+        _w = self.wo_a.weight
+        _w2d = getattr(self, "_o_proj_2d_weight", None)
+        if _w2d is None:
+            if _w.dim() == 3 and _w.shape[0] == 1:
+                _w2d = _w.squeeze(0)
+            elif _w.dim() == 2:
+                # `--load-format dummy` skips weight_loader, so the weight keeps
+                # its declared 2D layout [o_lora_rank, group_hidden]; a real 3D
+                # load never reaches this branch.
+                _w2d = _w.t().contiguous()
+            else:
+                _w2d = _w.reshape(-1, _w.shape[-1])
+            self._o_proj_2d_weight = _w2d
+        return torch.matmul(o_proj_input.reshape(o_proj_input.shape[0], -1), _w2d)
+
