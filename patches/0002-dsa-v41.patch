+    def _sentinel(self, value: float, dtype: torch.dtype) -> torch.Tensor:
+        """Return one reusable 0-d constant for ``torch.where`` sentinels.
+
+        ``torch.where(cond, x, -1)`` rebuilds a 0-d device tensor from the
+        Python scalar on every call, which shows up as ``aten::scalar_tensor``
+        in decode profiles (~20 us each, tens per step). A cached 0-d tensor
+        of the same dtype broadcasts identically without that cost.
+        """
+        key = (value, dtype)
+        tensor = self._sentinel_tensors.get(key)
+        if tensor is None:
+            tensor = torch.full((), value, dtype=dtype, device=self._device)
+            self._sentinel_tensors[key] = tensor
+        return tensor
+
