+# [MOE-MASK-RANGE] begin ------------------------------------------------------
+# Ported from deepseek-v4.1-flash-ascend910B:patches/files/token_dispatcher_moemask.py
+# (`V41_MOE_MASK_RANGE`, opt-in, default off = upstream behaviour).
+#
+# When the expert map is the standard linear EP placement -- the local experts
+# form one contiguous range and every other id maps to -1 -- the mask
+# `expert_map[topk_ids] != -1` is equivalent to a range compare, which drops the
+# aclnnIndex + IndexCheck pair per layer. The mask itself must stay: the -1 rows
+# of `expanded_row_idx` make unpermute read unwritten rows, and the zeroed
+# weight is what suppresses them.
+#
+# [SAFE-L1] The compare uses int32 0-dim tensors rather than Python ints: a
+# Python scalar makes LtScalar/GeScalar cast int32 topk_ids up to int64 first
+# (2 Cast per layer, measured 80/step at 40 layers). int32 -> int32 is identity
+# equivalent here because topk_ids, first and last all live in [0, E). Both
+# tensors are built once during the eager warm-up and reused at capture.
+_MOE_MASK_RANGE_FAST = os.environ.get("VLLM_ASCEND_V41_MOE_MASK_RANGE", "0") == "1"
+_MOE_MASK_RANGE_CACHE: dict = {}
+_MOE_MASK_RANGE_I32: dict = {}
+
+
+def _eplb_is_off() -> bool:
+    """EPLB (dynamic or forced) reshuffles expert_map, so the range form is invalid."""
+    try:
+        eplb = getattr(get_ascend_config(), "eplb_config", None)
+        if eplb is None:
+            return True
+        for _name in ("dynamic_eplb", "enable_eplb"):
+            if bool(getattr(eplb, _name, False)):
+                return False
+        return True
+    except Exception:
+        return False
+
+
+def _expert_map_is_contiguous_range(expert_map, first_expert_idx: int, last_expert_idx: int) -> bool:
+    """One-time content check: is expert_map exactly [first, last) -> 0..n-1, rest -1?"""
+    try:
+        _m = expert_map.detach().to("cpu", torch.int32).reshape(-1)
+        if _m.numel() < int(last_expert_idx):
+            return False
+        _expect = torch.full_like(_m, -1)
+        _expect[first_expert_idx:last_expert_idx] = torch.arange(
+            last_expert_idx - first_expert_idx, dtype=torch.int32
+        )
+        return bool(torch.equal(_m, _expect))
+    except Exception:
+        return False
+
+
+def _is_contiguous_local_range(expert_map, first_expert_idx: int, last_expert_idx: int) -> bool:
+    """Hot-path entry: EPLB off plus a cached (first, last, E)-scoped layout check.
+
+    The expert map layout is a property of the (rank, EP/EPLB config) pair, so
+    every layer under one config sees the same (first, last, E) and the same
+    layout. Checking once keeps this off the per-step path entirely.
+    """
+    if not _eplb_is_off():
+        return False
+    _key = (int(first_expert_idx), int(last_expert_idx), int(expert_map.numel()))
+    _cached = _MOE_MASK_RANGE_CACHE.get(_key)
+    if _cached is not None:
+        return _cached
+    _ok = _expert_map_is_contiguous_range(expert_map, first_expert_idx, last_expert_idx)
+    _MOE_MASK_RANGE_CACHE[_key] = _ok
+    return _ok
+
+
+def _i32_scalar(value: int, device) -> torch.Tensor:
+    key = (int(value), str(device))
+    t = _MOE_MASK_RANGE_I32.get(key)
+    if t is None:
+        t = torch.tensor(int(value), dtype=torch.int32, device=device)
+        _MOE_MASK_RANGE_I32[key] = t
+    return t
+
+
+# [MOE-MASK-RANGE] end --------------------------------------------------------
