diff --git a/vllm_ascend/distributed/kv_transfer/kv_pool/ascend_store/pool_scheduler.py b/vllm_ascend/distributed/kv_transfer/kv_pool/ascend_store/pool_scheduler.py
--- a/vllm_ascend/distributed/kv_transfer/kv_pool/ascend_store/pool_scheduler.py
+++ b/vllm_ascend/distributed/kv_transfer/kv_pool/ascend_store/pool_scheduler.py
@@ -862,6 +862,15 @@
         scheduler_output: SchedulerOutput,
         force_skip_save: bool,
     ) -> ReqMeta | None:
+        if self.vllm_config.use_v2_model_runner:
+            # MRV2 resumes preempted requests through scheduled_new_reqs with a
+            # full block table. Clear the marker so the next RUNNING delta
+            # extends this table instead of entering the preempted-request
+            # handler, which would replace the full table and reset save
+            # progress (associating the wrong blocks with pool keys).
+            # MRV1 resumes through cached requests and consumes the marker in
+            # _process_preempted_cached_request.
+            self._preempted_req_ids.discard(request.req_id)
         load_spec = self.load_specs.pop(request.req_id, None)
         num_tokens_to_compute = request.num_computed_tokens + scheduler_output.num_scheduled_tokens[request.req_id]
         request_tuple = self._unfinished_requests.get(request.req_id)
